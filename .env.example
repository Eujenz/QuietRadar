# 資料庫連線（預設使用本機 SQLite，若有 PostgreSQL 可替換為 postgresql+psycopg2://user:pass@localhost:5432/quietradar）
DATABASE_URL=sqlite:///./quietradar.db

# LLM 端點與金鑰（相容 OpenAI API 格式，如 NVIDIA NIM 免費端點、OpenAI、DeepSeek、Groq 等）
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.1-70b-instruct

# Bark 推播設定（請在 iOS 下載 Bark App 並複製專屬 Key）
BARK_SERVER_URL=https://api.day.app
BARK_DEVICE_KEY=your_bark_key_here
